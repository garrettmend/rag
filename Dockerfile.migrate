FROM postgres:16-alpine

# curl is used by the task's dns-update container, which reuses this image.
RUN apk add --no-cache curl

WORKDIR /migrations

COPY infra/migrate.sh /usr/local/bin/rag-migrate
COPY infra/sql/001_initial_schema.sql ./001_initial_schema.sql

RUN chmod +x /usr/local/bin/rag-migrate

ENTRYPOINT ["/usr/local/bin/rag-migrate"]
